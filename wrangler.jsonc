{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gobeyondinnovations",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "TEACHER_DB",
      "database_name": "gobeyond-teacher-verification",
      "database_id": "c136c38f-33a1-4fd8-8717-a18e1bd4fefd"
    }
  ]
}
